// prisma/schema.prisma
// Phase 2: Complete Core Domain Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ObjectiveType {
  IELTS
  TOEFL
  GENERAL_ENGLISH
  IMMIGRATION
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum AssessmentMethod {
  SELF_REPORTED
  MOCK_TEST
  FORMAL_EXAM
}

enum ExamType {
  IELTS
  TOEFL
  OTHER
}

enum ExamStatus {
  PLANNED
  REGISTERED
  COMPLETED
  CANCELLED
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  displayName String
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions         StudySession[]
  categories       Category[]
  plans            LongTermPlan[]
  goals            Goal[]
  levelAssessments LevelAssessment[]
  exams            Exam[]
  calendarSettings CalendarSetting?

  // Phase 9 — the objective the learner is currently working towards.
  //
  // Several objectives can exist at once (IELTS, TOEFL, General English,
  // Immigration, …); this single column says which one planning should default
  // to. It lives on the user rather than as a flag on the objective so that
  // "exactly one active objective" is a database guarantee instead of a rule
  // every writer has to remember. `SetNull` means deleting the focused objective
  // leaves the user with no focus rather than a dangling reference.
  objectives        LearningObjective[] @relation("UserObjectives")
  activeObjectiveId String?             @unique
  activeObjective   LearningObjective?  @relation("ActiveObjective", fields: [activeObjectiveId], references: [id], onDelete: SetNull)

  @@map("users")
}

// ─── Skills (Seed Data) ───────────────────────────────────────────────────────

model Skill {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isDefault   Boolean @default(true)
  sortOrder   Int     @default(0)

  sessions    StudySession[]
  goalTargets GoalSkillTarget[]
  milestones  PlanMilestone[]

  @@map("skills")
}

// ─── Categories (Seed & Custom) ──────────────────────────────────────────────

model Category {
  id          String  @id @default(uuid())
  userId      String? // null for system defaults; set for user-defined custom categories
  name        String
  description String?
  isDefault   Boolean @default(true)
  sortOrder   Int     @default(0)

  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

// ─── Study Activity (Source of Truth) ────────────────────────────────────────

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  skillId         String
  categoryId      String?
  topic           String?
  description     String?
  startedAt       DateTime // UTC
  endedAt         DateTime // UTC
  durationMinutes Int // Derived and stored for query performance (endedAt - startedAt)
  selfRating      Int? // 1 to 5 rating
  notes           String?
  isManual        Boolean  @default(false)
  planId          String?
  milestoneId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill          @relation(fields: [skillId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  plan      LongTermPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  milestone PlanMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, skillId])
  @@index([userId, categoryId])
  @@index([startedAt, endedAt])
  // Phase 8 analytics: longest-session lookup per user (ORDER BY duration DESC LIMIT 1).
  @@index([userId, durationMinutes])
  @@map("study_sessions")
}

// ─── Calendar Preferences (Phase 7) ──────────────────────────────────────────
//
// Thresholds that *interpret* study activity — how the heatmap buckets minutes
// and what makes a day qualify for the streak. Note what is deliberately absent:
// daily totals and streak counters are never stored. They are derived from
// `StudySession` rows on read, so study time keeps exactly one source of truth.

model CalendarSetting {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  intensityThresholds     Int[]    @default([20, 40, 60, 90])
  streakQualifyingMinutes Int      @default(20)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_settings")
}

// ─── Learning Objectives ─────────────────────────────────────────────────────

model LearningObjective {
  id          String        @id @default(uuid())
  userId      String
  type        ObjectiveType
  title       String
  description String?
  targetScore Float?
  targetDate  DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation("UserObjectives", fields: [userId], references: [id], onDelete: Cascade)

  // Present when this objective is the user's current focus (`users.active_objective_id`).
  activeForUser User? @relation("ActiveObjective")

  plans LongTermPlan[]
  goals Goal[]
  exams Exam[]

  @@index([userId, isActive])
  @@map("learning_objectives")
}

// ─── Long-Term Plans ─────────────────────────────────────────────────────────

model LongTermPlan {
  id            String    @id @default(uuid())
  userId        String
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  targetMinutes Int
  status        PlanStatus @default(ACTIVE)
  objectiveId   String?
  examId        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective LearningObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  exam      Exam?              @relation(fields: [examId], references: [id], onDelete: SetNull)

  milestones PlanMilestone[]
  goals      Goal[]
  sessions   StudySession[]

  @@index([userId, status])
  @@index([userId, startDate, endDate])
  @@map("long_term_plans")
}

// ─── Plan Milestones ─────────────────────────────────────────────────────────

model PlanMilestone {
  id            String     @id @default(uuid())
  planId        String
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  targetMinutes Int
  skillId       String?
  status        PlanStatus @default(ACTIVE)
  ordering      Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  plan  LongTermPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  skill Skill?         @relation(fields: [skillId], references: [id], onDelete: SetNull)
  sessions StudySession[]

  @@index([planId, ordering])
  @@index([planId, startDate, endDate])
  @@map("plan_milestones")
}

// ─── Goals ───────────────────────────────────────────────────────────────────

model Goal {
  id            String     @id @default(uuid())
  userId        String
  period        GoalPeriod
  targetMinutes Int
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean    @default(true)
  planId        String?
  objectiveId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      LongTermPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  objective LearningObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  skillTargets GoalSkillTarget[]

  @@index([userId, period, isActive])
  @@index([userId, startDate])
  @@map("goals")
}

model GoalSkillTarget {
  id            String @id @default(uuid())
  goalId        String
  skillId       String
  targetMinutes Int

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([goalId, skillId])
  @@map("goal_skill_targets")
}

// ─── Level Assessments (CEFR, Phase 9) ───────────────────────────────────────
//
// One row = one assessment event. Each of the five dimensions carries its own
// optional CEFR level, because a real assessment rarely covers all of them: a
// self-assessment may only rate speaking, a formal exam may report all four
// skills, and a placement test may report a single overall band. Every level is
// therefore nullable, and null means "not assessed" — never "unknown" and never
// "estimated".
//
// Levels here are *recorded*, never inferred: nothing links an assessment to
// `StudySession`, and no code path derives a CEFR level from study time.
// `cefrLevel` is the overall level of the assessment, which is why the four
// skill columns are the ones carrying a suffix.

model LevelAssessment {
  id             String           @id @default(uuid())
  userId         String
  cefrLevel      CefrLevel? // overall level of this assessment
  listeningLevel CefrLevel?
  readingLevel   CefrLevel?
  writingLevel   CefrLevel?
  speakingLevel  CefrLevel?
  assessedAt     DateTime
  method         AssessmentMethod
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assessedAt])
  @@map("level_assessments")
}

// ─── Exams ───────────────────────────────────────────────────────────────────

model Exam {
  id          String     @id @default(uuid())
  userId      String
  objectiveId String?
  type        ExamType
  title       String
  scheduledAt DateTime?
  venue       String?
  status      ExamStatus @default(PLANNED)
  // Target the learner set for this exam: an IELTS band, a TOEFL total, … or
  // whatever the resolved score scale calls it. Null when no target was set.
  targetScore Float?
  targetDate  DateTime?
  // Opaque scoring-scale descriptor (see `apps/api/src/modules/exams/exam.scoring.ts`).
  //
  // Stored as JSON on purpose: a scoring change (a new TOEFL format, a revised
  // band scale, a provider-specific mock scale) is a data or preset change, not a
  // schema migration. Null means "use the default scale for `type`".
  scoreScale Json?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective LearningObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  results ExamResult[]
  plans   LongTermPlan[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@map("exams")
}

model ExamResult {
  id           String   @id @default(uuid())
  examId       String
  isMock       Boolean  @default(false)
  takenAt      DateTime
  // Recorded as reported. Null when only section scores were recorded, so a
  // partial result never forces a fabricated total.
  overallScore Float?
  // Flexible JSON structure, e.g. { listening: 7.5, reading: 8.0, writing: 6.5, speaking: 7.0 }.
  // Keys are validated against the exam's resolved score scale, so a TOEFL total
  // of 120 or an IELTS band of 0.5 is stored and read back without a redesign.
  skillScores  Json
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, takenAt])
  @@map("exam_results")
}
