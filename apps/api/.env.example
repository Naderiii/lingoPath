NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://lingopath:lingopath_dev@localhost:5432/lingopath
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- AI recommendations (Phase 10) -----------------------------------------
# `none` is the default and a supported deployment: the engine then writes its
# recommendations from its own deterministic rules. Selecting a provider without
# a credential also falls back safely rather than failing to start.
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
RECOMMENDATION_MAX_ITEMS=4
